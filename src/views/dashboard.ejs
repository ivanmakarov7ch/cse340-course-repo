<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <h2>Dashboard</h2>
    <p>Name: <%= user.name %></p>
    <p>Email: <%= user.email %></p>
    <h3>My Volunteer Projects</h3>
    <% if (volunteerProjects.length > 0) { %>
        <ul>
            <% volunteerProjects.forEach(project => { %>
                <li>
                    <a href="/project/<%= project.project_id %>">
                        <%= project.title %>
                    </a>
                    (<%= new Date(project.date).toLocaleDateString() %>)
                    <form
                        action="/project/<%= project.project_id %>/unvolunteer"
                        method="POST"
                        style="display:inline;">
                        <button type="submit">
                            Remove
                        </button>
                    </form>
                </li>
            <% }) %>
        </ul>
    <% } else { %>
        <p>
            You have not volunteered for any projects yet.
        </p>
    <% } %>

    <% if (isLoggedIn && user.role_name === 'admin') { %>
        <p><a href="/users">Manage Users</a></p>
    <% } %>
</main>

<%- include('partials/footer') %>