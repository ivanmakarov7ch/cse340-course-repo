<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>
    <h2><%= project.title %></h2>
    <p>
        <strong>Description:</strong>
        <%= project.description %>
    </p>
    <p>
        <strong>Date:</strong>
        <%= new Date(project.date).toLocaleDateString() %>
    </p>
    <p>
        <strong>Location:</strong>
        <%= project.location %>
    </p>
    <p>
        <strong>Organization:</strong>
        <a href="/organization/<%= project.organization_id %>">
            <%= project.organization_name %>
        </a>
    </p>
    <p>
    <strong>Categories:</strong>
    <% if (categories && categories.length > 0) { %>
        <% categories.forEach(category => { %>
            <a href="/category/<%= category.category_id %>">
                <%= category.name %>
            </a>
        <% }) %>
    <% } else { %>
        No categories assigned.
    <% } %>
    </p>
    <% if (user) { %>
        <hr>
        <% if (!userIsVolunteer) { %>
            <form
             action="/project/<%= project.project_id %>/volunteer"
                method="POST">
                <button type="submit">
                 Volunteer for this Project
                </button>
            </form>
        <% } else { %>
            <p>
             <strong>
                    You are volunteering for this project.
              </strong>
            </p>
            <form
             action="/project/<%= project.project_id %>/unvolunteer"
             method="POST">
                <button type="submit">
                 Remove Volunteer Status
                </button>
         </form>
        <% } %>
    <% } %>
</main>

<%- include('partials/footer') %>