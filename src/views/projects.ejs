<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>
    <h2>Upcoming Service Projects</h2>
    <ul>
        <% projects.forEach(project => { %>
            <li>
                <!-- Project link -->
                <strong>
                    <a href="/project/<%= project.project_id %>">
                        <%= project.title %>
                    </a>
                </strong>
                <br>
                <!-- Organization link -->
                Organization:
                <a href="/organization/<%= project.organization_id %>">
                    <%= project.organization_name %>
                </a>
                <br>
                <!-- Date -->
                Date:
                <%= new Date(project.date).toLocaleDateString() %>
                <br>
                <!-- Description -->
                <%= project.description %>
                <br><br>
                <a href="/assign-categories/<%= project.project_id %>">Edit Categories</a>
            </li>
        <% }) %>
    </ul>
    <p><a href="/new-project">Add a New Service Project</a></p>
</main>

<%- include('partials/footer') %>

