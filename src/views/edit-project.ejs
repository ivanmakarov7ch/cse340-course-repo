<%- include('partials/header') %>

<main>
    <h1>Edit Project</h1>

    <form action="/edit-project/<%= project.project_id %>" method="POST">

        <!-- Title -->
        <div>
            <label>Title</label>
            <input type="text" name="title"
                value="<%= project.title %>" required>
        </div>

        <!-- Description -->
        <div>
            <label>Description</label>
            <textarea name="description" required><%= project.description %></textarea>
        </div>

        <!-- Location -->
        <div>
            <label>Location</label>
            <input type="text" name="location"
                value="<%= project.location %>" required>
        </div>

        <!-- Date -->
        <div>
            <label>Date</label>
            <input type="date" name="date"
                value="<%= project.date.toISOString().split('T')[0] %>" required>
        </div>

        <!-- Organization -->
        <div>
            <label>Organization</label>
            <select name="organizationId" required>
                <% organizations.forEach(org => { %>
                    <option value="<%= org.organization_id %>"
                        <%= org.organization_id === project.organization_id ? 'selected' : '' %>>
                        <%= org.name %>
                    </option>
                <% }) %>
            </select>
        </div>

        <button type="submit">Update Project</button>

    </form>
</main>

<%- include('partials/footer') %>